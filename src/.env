# ------------- app settings -------------
APP_NAME="Korean Learning App"
APP_DESCRIPTION="An Android app to learn Korean based on Seoul textbooks, with gamification and AI features."
APP_VERSION="0.1"
CONTACT_NAME="Hoa Bui"
CONTACT_EMAIL="buihuyhoaf@example.com"
LICENSE_NAME="MIT"

# ------------- database -------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_SERVER=db     # ⚠️ dùng 'db' vì Docker Compose sẽ tạo service tên db
POSTGRES_PORT=5432
POSTGRES_DB=korean_app

# ------------- pgadmin -------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_LISTEN_PORT=80