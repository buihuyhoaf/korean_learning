# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_URL=postgresql://postgres:postgres@db:5432/postgres

# Redis
REDIS_CACHE_HOST=redis
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=redis
REDIS_QUEUE_PORT=6379
REDIS_RATE_LIMIT_HOST=redis
REDIS_RATE_LIMIT_PORT=6379

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Korean Learning FastAPI
APP_DESCRIPTION=Korean Learning API
APP_VERSION=1.0.0
ENVIRONMENT=local

# Admin
CRUD_ADMIN_ENABLED=true
CRUD_ADMIN_MOUNT_PATH=/admin

# First User
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123

# Rate Limiting
DEFAULT_RATE_LIMIT_LIMIT=10
DEFAULT_RATE_LIMIT_PERIOD=3600
