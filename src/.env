# Database
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=korean_app
POSTGRES_URL=postgresql://dev:dev@db:5432/db


# Redis
REDIS_CACHE_HOST=redis
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=redis
REDIS_QUEUE_PORT=6379
REDIS_RATE_LIMIT_HOST=redis
REDIS_RATE_LIMIT_PORT=6379

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Korean Learning FastAPI
APP_DESCRIPTION=Korean Learning API
APP_VERSION=1.0.0
ENVIRONMENT=local

# Admin
CRUD_ADMIN_ENABLED=true
CRUD_ADMIN_MOUNT_PATH=/admin

# First User
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123

# Rate Limiting
DEFAULT_RATE_LIMIT_LIMIT=10
DEFAULT_RATE_LIMIT_PERIOD=3600

# Admin Interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ------------- pgadmin -------------
PGADMIN_DEFAULT_EMAIL="admin@gmail.com"
PGADMIN_DEFAULT_PASSWORD="123456"
PGADMIN_LISTEN_PORT=80
# Google Authentication
GOOGLE_CLIENT_ID=461063240681-81vk4ofnni0lru1vdmnmtvlrbd0k9hpt.apps.googleusercontent.com
